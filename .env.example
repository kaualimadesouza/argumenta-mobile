# Copy to .env and fill in for local development. Expo inlines EXPO_PUBLIC_*
# vars at build time; none of this is secret (it all ships inside the app
# bundle), so this is safe to keep as plain text.

# The argumenta-api base URL. Point this at your machine's LAN IP, not
# localhost: a physical device or the Android emulator cannot resolve your
# computer's localhost as itself.
EXPO_PUBLIC_API_URL=http://192.168.0.10:8000

# The Google OAuth client of type "Web application" (has a client_secret,
# configured server-side in argumenta-api). The mobile app never sees the
# secret: it only needs this client's public id to ask Google for a code that
# argumenta-api then exchanges. See docs/google-sign-in-setup.md.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
