{
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "argumenta-mobile",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "versioning-strategy": "always-bump-patch",
      "include-v-in-tag": false,
      "extra-files": [
        {
          "type": "json",
          "path": "app.json",
          "jsonpath": "$.expo.version"
        }
      ]
    }
  }
}
